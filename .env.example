# Telegram bot sozlamalari
# Ushbu qiymatlarni to'ldiring va .env.local fayl yarating:
#
# 1. @BotFather da yangi bot yarating → /newbot buyrug'ini yuboring
# 2. Olingan tokenni TELEGRAM_BOT_TOKEN ga qo'ying
# 3. Botni guruhga yoki kanalga qo'shing va chatId ni oling:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Bir nechta chatId uchun vergul bilan ajrating: "123456,789012"

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
